# Copy to .env. Never commit API keys. Compose overrides the native DATABASE_URL.
FRED_API_KEY=
DATA_PROVIDER=fred_csv
DATABASE_URL=postgresql+psycopg://macro:CHANGE_ME_LOCAL_ONLY@localhost:5432/macro
POSTGRES_USER=macro
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=macro
BACKEND_URL=http://localhost:8000
SYNC_START_DATE=1947-01-01
SYNC_LOOKBACK_DAYS=400
FRED_TIMEOUT_SECONDS=30
FRED_MAX_RETRIES=4
FRED_REQUESTS_PER_MINUTE=60

# Iteration 2: start-local.ps1 and Compose enable the worker automatically.
MONITOR_ENABLED=false
CALENDAR_REFRESH_SECONDS=21600
MONITOR_FAR_SECONDS=21600
MONITOR_DAY_SECONDS=1800
MONITOR_NEAR_SECONDS=300
MONITOR_LEASE_SECONDS=1800
MONITOR_DELAY_SECONDS=3600
MONITOR_EXPIRE_SECONDS=604800

# Iteration 3: date-level archive cache, seconds
VINTAGE_CACHE_SECONDS=3600

# Direct loopback diagnostics only; never proxied by Next.js
DIAGNOSTICS_ENABLED=false
