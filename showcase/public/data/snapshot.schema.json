{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "is_live",
    "revision_basis",
    "series",
    "fed_decisions",
    "source_checksums"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_live": {
      "const": false
    },
    "revision_basis": {
      "type": "string",
      "minLength": 30
    },
    "source_checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "native_id",
          "title",
          "title_zh",
          "units",
          "frequency",
          "seasonal_adjustment",
          "provider",
          "source",
          "source_url",
          "download_url",
          "policy_url",
          "permission",
          "status",
          "reviewed_on",
          "notice",
          "observations",
          "coverage",
          "generated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "native_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "title_zh": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "seasonal_adjustment": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "policy_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "frequency": {
            "enum": [
              "monthly",
              "daily"
            ]
          },
          "provider": {
            "enum": [
              "bls",
              "fed"
            ]
          },
          "permission": {
            "const": "public-domain"
          },
          "status": {
            "const": "approved"
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "maturity_months": {
            "type": "integer",
            "minimum": 0
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "value"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "count"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "fed_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "lower",
          "upper",
          "units",
          "source",
          "source_url",
          "verified_at",
          "notice"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "lower": {
            "type": "number"
          },
          "upper": {
            "type": "number"
          },
          "units": {
            "const": "Percent"
          },
          "source": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "notice": {
            "type": "string"
          }
        }
      }
    }
  }
}
